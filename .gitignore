```gitignore
# ============================================================
# Programming_Lab
# C++ / C# / Unity Study & Research Repository
# ============================================================
#
# Repository Root:
#
# Programming_Lab/
# ├── .gitignore
# ├── README.md
# ├── Cpp/
# ├── CSharp/
# └── UnityLab/
#
# Unity-specific ignore rules are restricted to /UnityLab/.
# ============================================================


# ============================================================
# Visual Studio
# ============================================================

# Visual Studio local cache
.vs/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio database / cache
*.VC.db
*.VC.VC.opendb
*.opendb
*.sdf
*.opensdf
*.ncb
*.ipch

# Visual Studio generated cache
*.sln.cache


# ============================================================
# C / C++ Build Artifacts
# ============================================================

# Object files
*.o
*.obj
*.lo

# Precompiled headers
*.pch
*.gch

# Debug information
*.pdb
*.idb
*.ilk

# Compiler generated files
*.tlog
*.lastbuildstate

# Static libraries
*.lib
*.a
*.la
*.lai

# Shared libraries
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app

# Intermediate compiler files
*.i
*.ii
*.s

# Dependency files
*.d


# ============================================================
# Visual Studio / MSBuild Output
# ============================================================

[Dd]ebug/
[Dd]ebugPublic/

[Rr]elease/
[Rr]eleases/

x64/
x86/
ARM/
ARM64/

[Bb]in/
[Oo]bj/

bld/
[Bb]uild[Ll]og.*


# ============================================================
# C# / .NET
# ============================================================

# Build output
[Bb]in/
[Oo]bj/

# NuGet package output
*.nupkg
*.snupkg

# Legacy NuGet packages directory
packages/

# NuGet generated files
*.nuget.props
*.nuget.targets

# .NET generated artifacts
artifacts/


# ============================================================
# Rider / JetBrains
# ============================================================

.idea/
.idea_modules/

*.sln.iml
*.DotSettings.user


# ============================================================
# VS Code
# ============================================================

# Local VS Code settings
.vscode/

# If you later want to share VS Code configuration,
# remove ".vscode/" and selectively ignore files instead.


# ============================================================
# UnityLab
# ============================================================
#
# All Unity-specific rules are restricted to /UnityLab/.
#
# This means standalone C++ / C# project files such as:
#
# Cpp/MyProject/MyProject.sln
# CSharp/MyProject/MyProject.sln
# CSharp/MyProject/MyProject.csproj
#
# are NOT ignored.
# ============================================================


# ------------------------------------------------------------
# Unity Generated Directories
# ------------------------------------------------------------

/UnityLab/**/[Ll]ibrary/
/UnityLab/**/[Tt]emp/
/UnityLab/**/[Oo]bj/
/UnityLab/**/[Ll]ogs/
/UnityLab/**/[Uu]ser[Ss]ettings/

/UnityLab/**/[Mm]emoryCaptures/
/UnityLab/**/[Rr]ecordings/


# ------------------------------------------------------------
# Unity Build Output
# ------------------------------------------------------------

/UnityLab/**/[Bb]uild/
/UnityLab/**/[Bb]uilds/


# ------------------------------------------------------------
# Unity Generated IDE Project Files
# ------------------------------------------------------------

/UnityLab/**/*.csproj
/UnityLab/**/*.sln
/UnityLab/**/*.slnx
/UnityLab/**/*.unityproj

/UnityLab/**/*.pidb
/UnityLab/**/*.booproj
/UnityLab/**/*.svd

/UnityLab/**/*.opendb
/UnityLab/**/*.VC.db


# ------------------------------------------------------------
# Unity Generated Debug Files
# ------------------------------------------------------------

/UnityLab/**/*.pdb
/UnityLab/**/*.mdb

/UnityLab/**/*.pidb.meta
/UnityLab/**/*.pdb.meta
/UnityLab/**/*.mdb.meta


# ------------------------------------------------------------
# Unity Crash Reports
# ------------------------------------------------------------

/UnityLab/**/sysinfo.txt


# ------------------------------------------------------------
# Unity Asset Store Tools
# ------------------------------------------------------------

/UnityLab/**/[Aa]ssets/AssetStoreTools*


# ------------------------------------------------------------
# Unity Build Packages
# ------------------------------------------------------------

/UnityLab/**/*.apk
/UnityLab/**/*.aab
/UnityLab/**/*.unitypackage


# ============================================================
# Unity Addressables
# ============================================================

/UnityLab/**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

/UnityLab/**/[Aa]ssets/[Ss]treamingAssets/aa.meta
/UnityLab/**/[Aa]ssets/[Ss]treamingAssets/aa/*


# ============================================================
# Unity - IMPORTANT
# ============================================================
#
# The following should remain tracked:
#
# Assets/
# Packages/
# ProjectSettings/
# *.meta
#
# Unity .meta files contain GUIDs used for asset references.
# Never globally ignore *.meta files.
# ============================================================


# ============================================================
# CMake
# ============================================================

CMakeFiles/
CMakeCache.txt

cmake_install.cmake
CTestTestfile.cmake

compile_commands.json

# Common CMake build directories
cmake-build-*/

out/build/


# ============================================================
# Package / Dependency Managers
# ============================================================

# vcpkg
vcpkg_installed/

# Conan
.conan/
.conan2/


# ============================================================
# Test / Coverage
# ============================================================

TestResults/
[Tt]est[Rr]esult*/

coverage/
coverage.*

*.coverage
*.coveragexml


# ============================================================
# Benchmark
# ============================================================

BenchmarkDotNet.Artifacts/


# ============================================================
# Temporary Files
# ============================================================

*.tmp
*.temp

*.bak
*.backup

*.swp
*.swo

*~
~$*


# ============================================================
# Logs
# ============================================================

*.log
logs/


# ============================================================
# Windows
# ============================================================

Thumbs.db
Thumbs.db:encryptable

ehthumbs.db
ehthumbs_vista.db

Desktop.ini

$RECYCLE.BIN/


# ============================================================
# macOS
# ============================================================

.DS_Store
.AppleDouble
.LSOverride

._*


# ============================================================
# Linux
# ============================================================

.directory
.Trash-*


# ============================================================
# Intentionally Tracked Files
# ============================================================
#
# C / C++
#   *.c
#   *.cpp
#   *.h
#   *.hpp
#
# C# / .NET
#   *.cs
#   *.csproj
#   *.sln
#
# Unity
#   Assets/
#   Packages/
#   ProjectSettings/
#   *.meta
#
# Documentation
#   *.md
#
# ============================================================
```