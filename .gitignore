```gitignore
# ============================================================
# Study_Lab
# C++ / C# / Unity
# Visual Studio / Rider / VS Code
# ============================================================


# ============================================================
# Visual Studio
# ============================================================

.vs/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio cache / database
*.VC.db
*.VC.VC.opendb
*.opendb
*.sdf
*.opensdf
*.ncb
*.ipch

# Visual Studio generated files
*.sln.cache


# ============================================================
# C / C++ Build Artifacts
# ============================================================

# Object files
*.o
*.obj
*.lo

# Precompiled headers
*.pch
*.gch

# Debug information
*.pdb
*.idb
*.ilk

# Compiler generated files
*.tlog
*.lastbuildstate

# Libraries
*.lib
*.a
*.la
*.lai

# Shared libraries
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app

# Intermediate files
*.i
*.ii
*.s

# Dependency files
*.d


# ============================================================
# Visual Studio / MSBuild Output
# ============================================================

[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/

x64/
x86/
ARM/
ARM64/

[Bb]in/
[Oo]bj/

bld/
[Bb]uild[Ll]og.*

# MSBuild
*.cache
*.log


# ============================================================
# C# / .NET
# ============================================================

[Bb]in/
[Oo]bj/

# .NET generated files
*.dll
*.exe
*.pdb

# NuGet
*.nupkg
*.snupkg

# NuGet packages are restored automatically
packages/

# NuGet generated files
*.nuget.props
*.nuget.targets

# .NET tooling
artifacts/


# ============================================================
# Rider / JetBrains
# ============================================================

.idea/

*.sln.iml
*.DotSettings.user

# Rider generated files
.idea_modules/


# ============================================================
# VS Code
# ============================================================

# Ignore local VS Code workspace settings
.vscode/

# If you later want to share VS Code configuration,
# remove ".vscode/" above and selectively ignore files instead.


# ============================================================
# Unity
# ============================================================

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Memory / profiling
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset Store tools
[Aa]ssets/AssetStoreTools*

# Unity generated project files
*.csproj
*.sln
*.slnx
*.unityproj

# Unity generated IDE files
*.pidb
*.booproj
*.svd

# Unity generated debug files
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports
sysinfo.txt

# Unity temporary files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity build output
*.apk
*.aab
*.unitypackage


# ============================================================
# Unity Addressables
# ============================================================

[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Addressables temporary state
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*


# ============================================================
# Test / Coverage
# ============================================================

TestResults/
[Tt]est[Rr]esult*/

coverage/
coverage.*

*.coverage
*.coveragexml


# ============================================================
# Benchmark
# ============================================================

BenchmarkDotNet.Artifacts/


# ============================================================
# CMake
# ============================================================

CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake

compile_commands.json

# Common CMake build directories
cmake-build-*/
out/build/


# ============================================================
# Package / Dependency Managers
# ============================================================

# vcpkg installed dependencies
vcpkg_installed/

# Conan
.conan/
.conan2/


# ============================================================
# Temporary Files
# ============================================================

*.tmp
*.temp
*.bak
*.backup

*.swp
*.swo

*~
~$*


# ============================================================
# Windows
# ============================================================

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

Desktop.ini

$RECYCLE.BIN/


# ============================================================
# macOS
# ============================================================

.DS_Store
.AppleDouble
.LSOverride

._*


# ============================================================
# Linux
# ============================================================

.directory
.Trash-*


# ============================================================
# Logs
# ============================================================

*.log
logs/


# ============================================================
# Keep important source / project files
# ============================================================

# These are intentionally NOT ignored:
#
# *.cpp
# *.h
# *.hpp
# *.c
# *.cs
#
# *.sln / *.csproj are normally useful for standalone
# Visual Studio projects, but Unity regenerates them.
#
# Unity:
# Assets/
# Packages/
# ProjectSettings/
#
# Documentation:
# *.md
#
# Git:
# .gitignore
```